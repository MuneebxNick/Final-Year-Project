# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
backend/.env

# Kaggle credentials — token lives in ~/.kaggle/access_token, never in the repo
.kaggle/
kaggle.json
**/access_token
backend/data/kaggle/
backend/.venv/
backend/**/__pycache__/
**/__pycache__/
*.pyc

# YOLO weights downloaded at runtime — do not commit
*.pt

# Local detection test fixtures (binaries; report lives in docs/)
backend/test_images/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
